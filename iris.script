    zn "%SYS"

    // Create roles with tiered permissions
    If '##class(Security.Roles).Exists("Admin") {
        Set r("Description") = "Full system administration"
        Do ##class(Security.Roles).Create("Admin", .r)
    }
    If '##class(Security.Roles).Exists("Auditor") {
        Set r("Description") = "Claim review: approve, reject, escalate"
        Do ##class(Security.Roles).Create("Auditor", .r)
    }
    If '##class(Security.Roles).Exists("Viewer") {
        Set r("Description") = "Read-only dashboard access"
        Do ##class(Security.Roles).Create("Viewer", .r)
    }
    If '##class(Security.Roles).Exists("Specialist") {
        Set r("Description") = "Claim review: approve, reject, escalate"
        Do ##class(Security.Roles).Create("Specialist", .r)
    }
    If '##class(Security.Roles).Exists("Director") {
        Set r("Description") = "Claim review: approve, reject, final override"
        Do ##class(Security.Roles).Create("Director", .r)
    }

    // Create users with full-name and password
    If '##class(Security.Users).Exists("admin") {
        Set u("FullName") = "ClaimAuditAI Admin"
        Set u("Password") = "ClaimAuditAdmin2026!"
        Set u("Roles") = "Admin"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("admin", .u)
    }
    If '##class(Security.Users).Exists("auditor") {
        Set u("FullName") = "ClaimAuditAI Auditor"
        Set u("Password") = "AuditReview2026!"
        Set u("Roles") = "Auditor"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("auditor", .u)
    }
    If '##class(Security.Users).Exists("viewer") {
        Set u("FullName") = "ClaimAuditAI Viewer"
        Set u("Password") = "ViewDash2026!"
        Set u("Roles") = "Viewer"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("viewer", .u)
    }
    If '##class(Security.Users).Exists("specialist") {
        Set u("FullName") = "ClaimAuditAI Specialist"
        Set u("Password") = "ReviewSpec2026!"
        Set u("Roles") = "Specialist"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("specialist", .u)
    }
    If '##class(Security.Users).Exists("director") {
        Set u("FullName") = "ClaimAuditAI Director"
        Set u("Password") = "DirectorAudit2026!"
        Set u("Roles") = "Director"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("director", .u)
    }

    // Ensure roles are stored in globals (backup in case Security.Users.Create doesn't persist)
    Set ^SYS("Security","Users","admin","Roles","Admin") = ""
    Set ^SYS("Security","Users","admin","Roles","%DB_INTEROP-CODE") = ""
    Set ^SYS("Security","Users","admin","Roles","%DB_INTEROP-DATA") = ""
    Set ^SYS("Security","Users","auditor","Roles","Auditor") = ""
    Set ^SYS("Security","Users","auditor","Roles","%DB_INTEROP-CODE") = ""
    Set ^SYS("Security","Users","auditor","Roles","%DB_INTEROP-DATA") = ""
    Set ^SYS("Security","Users","viewer","Roles","Viewer") = ""
    Set ^SYS("Security","Users","viewer","Roles","%DB_INTEROP-CODE") = ""
    Set ^SYS("Security","Users","viewer","Roles","%DB_INTEROP-DATA") = ""
    Set ^SYS("Security","Users","specialist","Roles","Specialist") = ""
    Set ^SYS("Security","Users","specialist","Roles","%DB_INTEROP-CODE") = ""
    Set ^SYS("Security","Users","specialist","Roles","%DB_INTEROP-DATA") = ""
    Set ^SYS("Security","Users","director","Roles","Director") = ""
    Set ^SYS("Security","Users","director","Roles","%DB_INTEROP-CODE") = ""
    Set ^SYS("Security","Users","director","Roles","%DB_INTEROP-DATA") = ""

    // Enable callin for Embedded Python
    do ##class(Security.Services).Get("%Service_CallIn",.prop)
    set prop("Enabled")=1
    set prop("AutheEnabled")=48
    do ##class(Security.Services).Modify("%Service_CallIn",.prop)

    // Load installer manifest and configure INTEROP namespace
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/iris/installer.cls", "ck")
    set sc = ##class(ClaimAudit.Installer).setup()

    zpm "enable -community"

    zn "INTEROP"

    // Store credential hashes + roles in INTEROP globals — CSP runs as UnknownUser without %SYS access
    Set tSalt = "ClaimAuditAI_Salt"
    Set ^ClaimAuditAI("Users","admin","hash") = $SYSTEM.Encryption.HMACSHA(256, "ClaimAuditAdmin2026!", tSalt)
    Set ^ClaimAuditAI("Users","admin","fullName") = "ClaimAuditAI Admin"
    Set ^ClaimAuditAI("Users","admin","roles","Admin") = ""
    Set ^ClaimAuditAI("Users","auditor","hash") = $SYSTEM.Encryption.HMACSHA(256, "AuditReview2026!", tSalt)
    Set ^ClaimAuditAI("Users","auditor","fullName") = "ClaimAuditAI Auditor"
    Set ^ClaimAuditAI("Users","auditor","roles","Auditor") = ""
    Set ^ClaimAuditAI("Users","viewer","hash") = $SYSTEM.Encryption.HMACSHA(256, "ViewDash2026!", tSalt)
    Set ^ClaimAuditAI("Users","viewer","fullName") = "ClaimAuditAI Viewer"
    Set ^ClaimAuditAI("Users","viewer","roles","Viewer") = ""
    Set ^ClaimAuditAI("Users","specialist","hash") = $SYSTEM.Encryption.HMACSHA(256, "ReviewSpec2026!", tSalt)
    Set ^ClaimAuditAI("Users","specialist","fullName") = "ClaimAuditAI Specialist"
    Set ^ClaimAuditAI("Users","specialist","roles","Specialist") = ""
    Set ^ClaimAuditAI("Users","director","hash") = $SYSTEM.Encryption.HMACSHA(256, "DirectorAudit2026!", tSalt)
    Set ^ClaimAuditAI("Users","director","fullName") = "ClaimAuditAI Director"
    Set ^ClaimAuditAI("Users","director","roles","Director") = ""

    // Create /_vscode web app to support VS Code extension testing
    zpm "install vscode-per-namespace-settings"

    // Configure %UnitTest in INTEROP
    set ^UnitTestRoot="/usr/irissys/.vscode/INTEROP/UnitTestRoot"

    // Compile FHIR-dependent classes FIRST so they are available for FHIR server creation
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/cls/ClaimAudit/FHIR/InteractionsStrategy.cls", "ck")
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/cls/ClaimAudit/FHIR/Interactions.cls", "ck")
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/cls/ClaimAudit/FHIR/RepoManager.cls", "ck")

    // Initialize FHIR metadata and create FHIR server endpoint at /fhir/r4
    do ##class(HS.FHIRServer.Installer).InstallNamespace()
    do ##class(HS.FHIRServer.Installer).InstallInstance("/fhir/r4", "ClaimAudit.FHIR.InteractionsStrategy", "hl7.fhir.r4.core@4.0.1")
    write "FHIR server created at /fhir/r4", !
    zn "%SYS"
    if ##class(Security.Applications).Exists("/fhir/r4") { do ##class(Security.Applications).Get("/fhir/r4", .prop) set prop("MatchRoles") = ":%DB_INTEROP-CODE:%DB_INTEROP-DATA" do ##class(Security.Applications).Modify("/fhir/r4", .prop) write "FHIR server application secured", ! }
    zn "INTEROP"

// Compile all custom classes recursively
do $SYSTEM.OBJ.LoadDir("/home/irisowner/dev/src/cls", "ckr", , 1)

// Grant permissions and initialize DB tables + AI models during build
do ##class(ClaimAudit.Debug).GrantRolesToUnknownUser()
do ##class(ClaimAudit.AI.Engine).Setup()

// Register the REST Web Application
zn "%SYS"
set name="/api", p("DispatchClass")="ClaimAudit.REST.Router", p("NameSpace")="INTEROP", p("AutheEnabled")=96, p("Recurse")=1, p("MatchRoles")=":%DB_INTEROP-CODE:%DB_INTEROP-DATA:%Admin_Secure"
if '##class(Security.Applications).Exists(name) {
    do ##class(Security.Applications).Create(name, .p)
    write "/api web app created", !
} else {
    do ##class(Security.Applications).Modify(name, .p)
    write "/api web app modified", !
}

// Load ZPM ClaimAuditAI package (must be LAST)
zn "INTEROP"
zpm "load /home/irisowner/dev/ -v":1:1

halt