    zn "%SYS"

    // Create roles with tiered permissions
    If '##class(Security.Roles).Exists("Admin") {
        Set r("Description") = "Full system administration"
        Do ##class(Security.Roles).Create("Admin", .r)
    }
    If '##class(Security.Roles).Exists("Auditor") {
        Set r("Description") = "Claim review: approve, reject, escalate"
        Do ##class(Security.Roles).Create("Auditor", .r)
    }
    If '##class(Security.Roles).Exists("Viewer") {
        Set r("Description") = "Read-only dashboard access"
        Do ##class(Security.Roles).Create("Viewer", .r)
    }

    // Create users with full-name and password
    If '##class(Security.Users).Exists("admin") {
        Set u("FullName") = "ClaimAuditAI Admin"
        Set u("Password") = "ClaimAuditAdmin2026!"
        Set u("Roles") = "%All"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("admin", .u)
    }
    If '##class(Security.Users).Exists("auditor") {
        Set u("FullName") = "ClaimAuditAI Auditor"
        Set u("Password") = "AuditReview2026!"
        Set u("Roles") = "%All"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("auditor", .u)
    }
    If '##class(Security.Users).Exists("viewer") {
        Set u("FullName") = "ClaimAuditAI Viewer"
        Set u("Password") = "ViewDash2026!"
        Set u("Roles") = "%All"
        Set u("ChangePassword") = 0
        Set u("Enabled") = 1
        Do ##class(Security.Users).Create("viewer", .u)
    }

    // Ensure roles are stored in globals (backup in case Security.Users.Create doesn't persist)
    Set ^SYS("Security","Users","admin","Roles","%All") = ""
    Set ^SYS("Security","Users","auditor","Roles","%All") = ""
    Set ^SYS("Security","Users","viewer","Roles","%All") = ""

    // Enable callin for Embedded Python
    do ##class(Security.Services).Get("%Service_CallIn",.prop)
    set prop("Enabled")=1
    set prop("AutheEnabled")=48
    do ##class(Security.Services).Modify("%Service_CallIn",.prop)

    // Load installer manifest and configure INTEROP namespace
    do $SYSTEM.OBJ.Load("/home/irisowner/dev/iris/installer.cls", "ck")
    set sc = ##class(ClaimAudit.Installer).setup()

    zpm "enable -community"

    zn "INTEROP"

    // Create /_vscode web app to support VS Code extension testing
    zpm "install vscode-per-namespace-settings"

    // Configure %UnitTest in INTEROP
    set ^UnitTestRoot="/usr/irissys/.vscode/INTEROP/UnitTestRoot"

// Compile non-FHIR-dependent classes before ZPM
do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/cls/ClaimAudit/REST/Router.cls", "ck")
do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/cls/ClaimAudit/AI/Engine.cls", "ck")
do $SYSTEM.OBJ.Load("/home/irisowner/dev/src/cls/ClaimAudit/AI/Agent.cls", "ck")

// Register the REST Web Application
zn "%SYS"
set name="/api", p("DispatchClass")="ClaimAudit.REST.Router", p("NameSpace")="INTEROP", p("AutheEnabled")=96, p("Recurse")=1, p("MatchRoles")=":%All"
if '##class(Security.Applications).Exists(name) {
    do ##class(Security.Applications).Create(name, .p)
    write "/api web app created", !
} else {
    do ##class(Security.Applications).Modify(name, .p)
    write "/api web app modified", !
}

// Load ZPM ClaimAuditAI package (must be LAST)
zn "INTEROP"
zpm "load /home/irisowner/dev/ -v":1:1

halt