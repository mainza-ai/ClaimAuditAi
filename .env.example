# LLM Credentials and Configuration
# Provider choices: nvidia, ollama, openai
LLM_PROVIDER=nvidia

# JWT Authentication
# Generate a secure 32-byte hex secret: openssl rand -hex 32
JWT_SECRET=YOUR_32_BYTE_HEX_SECRET
JWT_EXPIRY=86400
CLAIMAUDIT_ENV=development

# NVIDIA Configuration (Default Cloud LLM)
NVIDIA_API_KEY=YOUR_NVIDIA_API_KEY
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# OLLAMA Configuration (Local LLM Option)
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3

# OPENAI Configuration (Alternative)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# InterSystems FHIR Strategy Customization Settings (handled by ClaimAudit.FHIR.Interactions.cls)
# FHIR_CUSTOMIZATION_PATH=/home/irisowner/dev/src/python
# FHIR_CUSTOMIZATION_MODULE=claim_interceptor
# INTERACTION_PATH=/home/irisowner/dev/src/python
# INTERACTION_MODULE=claim_interceptor
# INTERACTION_CLASS=ClaimInterceptor
